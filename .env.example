# Application
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Anthropic (Claude API) for AI summarization
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email Delivery (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=bulletin@yourdomain.com
FROM_NAME=Daily Bulletin

# News Sources
NEWS_API_KEY=your-newsapi-key

# Credential Encryption
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-base64

# Database
DATABASE_URL=sqlite:///bulletin.db

# Scheduler
SEND_HOUR=7
SEND_MINUTE=0
TIMEZONE=America/New_York

# Podcast Watcher
# Comma-separated RSS feed URLs to monitor daily
PODCAST_FEEDS=https://feeds.example.com/podcast1.xml,https://feeds.example.com/podcast2.xml
# Email address to receive podcast summaries
PODCAST_EMAIL=you@example.com
# File to track already-processed episodes (auto-created)
PODCAST_SEEN_DB=podcast_seen.json
