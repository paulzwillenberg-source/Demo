# Application
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Anthropic (Claude API) for AI summarization
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email Delivery (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=bulletin@yourdomain.com
FROM_NAME=Daily Bulletin

# News Sources
NEWS_API_KEY=your-newsapi-key

# Credential Encryption
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-base64

# Database
DATABASE_URL=sqlite:///bulletin.db

# Scheduler
SEND_HOUR=7
SEND_MINUTE=0
TIMEZONE=America/New_York

# ── Vintage Scout ──────────────────────────────────────────────────────────────

# Twilio WhatsApp Business API (start approval process early — up to 7 days)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Redis dedup cache (optional — SQLite fallback used automatically if unset)
REDIS_URL=redis://localhost:6379/0

# Scraping (PROXY_URL optional; required for Tier 3 scrapers)
PROXY_URL=http://user:pass@proxy.example.com:8080
SCRAPE_INTERVAL_MINUTES=15
SCRAPE_MAX_PAGES=3
# Comma-separated slugs. Tier 3 (depop, vinted) off by default.
ENABLED_SCRAPERS=beyond_retro,thrifted

# Vintage digest delivery time
VINTAGE_DIGEST_HOUR=8
VINTAGE_DIGEST_MINUTE=0
