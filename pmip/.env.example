# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/pmip"

# Server
PORT=3001
NODE_ENV=development
SESSION_TOKEN=your-secret-session-token-here

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-...

# Kalshi API
KALSHI_API_KEY=your-kalshi-api-key

# Resend (email delivery)
RESEND_API_KEY=re_...
BRIEFING_EMAIL=your@email.com

# Gmail OAuth (newsletter ingestion)
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Frontend
VITE_API_URL=http://localhost:3001
VITE_SESSION_TOKEN=your-secret-session-token-here
